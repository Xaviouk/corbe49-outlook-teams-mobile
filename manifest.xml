<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
  <Id>4b7b8c2e-1f4a-4a7a-9f12-49cbe4900049</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>CORBE49</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="CORBE49 — Transfert Outlook vers Teams"/>
  <Description DefaultValue="Transférer un e-mail Outlook vers une conversation Microsoft Teams."/>
  <IconUrl DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/Xaviouk/corbe49-outlook-teams-mobile"/>
  <AppDomains>
    <AppDomain>https://xaviouk.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
    <Description resid="residDescription"/>
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <MobileFormFactor>
          <FunctionFile resid="residFunctionFile"/>
          <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
            <Group id="corbe49TeamsGroup">
              <Label resid="residGroupLabel"/>
              <Control xsi:type="MobileButton" id="corbe49ForwardToTeams">
                <Label resid="residButtonLabel"/>
                <Icon>
                  <bt:Image size="25" resid="icon25"/>
                  <bt:Image size="32" resid="icon32"/>
                  <bt:Image size="48" resid="icon48"/>
                </Icon>
                <Action xsi:type="ShowTaskpane">
                  <SourceLocation resid="residTaskpaneUrl"/>
                </Action>
              </Control>
            </Group>
          </ExtensionPoint>
        </MobileFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="icon25" DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/assets/icon-25.png"/>
        <bt:Image id="icon32" DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/assets/icon-32.png"/>
        <bt:Image id="icon48" DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/assets/icon-48.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="residFunctionFile" DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/taskpane.html"/>
        <bt:Url id="residTaskpaneUrl" DefaultValue="https://xaviouk.github.io/corbe49-outlook-teams-mobile/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="residGroupLabel" DefaultValue="CORBE49 Teams"/>
        <bt:String id="residButtonLabel" DefaultValue="Transférer vers Teams"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="residDescription" DefaultValue="Transférer un e-mail Outlook vers une conversation Microsoft Teams."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>